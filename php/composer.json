{
    "name": "apiverve/truthordare",
    "description": "The Truth or Dare API generates random truth questions and dare challenges for the classic party game. Features 400+ unique prompts with per-API-key tracking to avoid repeats.",
    "version": "1.2.2",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "truthordare",
        "truth or dare api",
        "truth and dare api",
        "random truth or dare questions",
        "truth or dare",
        "party game prompts"
    ],
    "homepage": "https://apiverve.com/marketplace/truthordare?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/truthordare",
        "source": "https://github.com/apiverve/truthordare-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Truthordare\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Truthordare\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
